{
  "name": "@reservai/agent-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node22 --clean --no-splitting",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.2.2",
    "@reservai/ai": "workspace:*",
    "@reservai/config": "workspace:*",
    "@reservai/core": "workspace:*",
    "@reservai/db": "workspace:*",
    "@sentry/node": "^8.47.0",
    "bullmq": "^5.34.5",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "tsup": {
    "noExternal": [
      "@reservai/ai",
      "@reservai/config",
      "@reservai/core",
      "@reservai/db"
    ]
  }
}
