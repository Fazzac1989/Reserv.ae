# Expo reads EXPO_PUBLIC_* into the client bundle. Nothing secret belongs here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AGENT_SERVICE_URL=http://127.0.0.1:3030

# Optional. Sign in with Google appears only when this is set — an unconfigured
# provider must not render a button that fails on tap.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
