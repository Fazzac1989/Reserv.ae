# ─────────────────────────────────────────────────────────────────────────────
# reservAI — root example environment
#
# Copy to .env and fill in. Never commit .env. Never put real venue contact
# details (phone numbers, WhatsApp numbers, named contacts) in any committed
# file — those live in the Supabase venue CRM only.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# demo | development | staging | production
# `demo` forces clearly-fictional seed data and disables all outbound rails.
RESERVAI_ENV=development

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
# Server-side only. Never expose to mobile or ops client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis / BullMQ --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- AI --------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model routing: fast model parses intent and drafts WhatsApp; strong model
# ranks suggestions and reasons about negotiation.
# Both models must support adaptive thinking and output_config.effort, which
# every request uses. Haiku 4.5 and anything older take neither and answer 400.
AI_MODEL_FAST=claude-sonnet-5
AI_MODEL_STRONG=claude-opus-5
# Transcription for user voice notes.
AI_TRANSCRIPTION_PROVIDER=openai-whisper
AI_TRANSCRIPTION_API_KEY=

# --- WhatsApp (Phase 6) ----------------------------------------------------
# BSP choice is an open decision — see Section 9 of the build plan.
WHATSAPP_BSP=unset
WHATSAPP_CONCIERGE_NUMBER_ID=
WHATSAPP_BOOKER_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Voice (Phase 9) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_NUMBER=

# --- Stripe (dormant, feature-flagged) ------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature flags ---------------------------------------------------------
# No fake integrations: a rail that is off is visibly disabled, never mocked
# in a production path.
FLAG_RAIL_API=false
FLAG_RAIL_WHATSAPP=false
FLAG_RAIL_VOICE=false
FLAG_RAIL_MANUAL=true
FLAG_STRIPE_SUBSCRIPTIONS=false
FLAG_PROACTIVE_SUGGESTIONS=false

# --- Service wiring --------------------------------------------------------
AGENT_SERVICE_PORT=3030
AGENT_SERVICE_URL=http://127.0.0.1:3030
# Shared secret for ops -> agent-service internal calls.
# At least 16 characters. The service refuses to start below that, because a
# short shared secret is worse than an obviously absent one.
INTERNAL_API_SECRET=

# Encrypts the tokens that let Riva read a connected calendar. Without this the
# OAuth routes refuse to run rather than storing a refresh token in the clear.
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud > APIs & Services > Credentials > OAuth client (Web application).
# The redirect URI must match what is registered there, character for character.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://reserv-agent.fly.dev/connections/google/callback
